# Kaggle (solo per scaricare il dataset)
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=arhamrumi/amazon-product-reviews

# Provider condiviso (OpenRouter / endpoint OpenAI-compatibile / Ollama se API_KEY è vuota)
BASE_URL=https://openrouter.ai/api/v1
API_KEY=

# Modelli di default (modificabili dalla GUI, pagina "Modelli & API")
LLM_MODEL=deepseek/deepseek-chat
EMBEDDING_MODEL=openai/text-embedding-3-large

# Prestazioni e nomi (modificabili dalla GUI)
LLM_CONCURRENCY=4
EMBEDDING_CONCURRENCY=4
LABEL_LANGUAGE=Italian

# Opzionali: provider separati per chat ed embedding (hanno priorità su BASE_URL/API_KEY)
# LLM_BASE_URL=
# LLM_API_KEY=
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=
